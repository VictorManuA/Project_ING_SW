{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "studytime",
  "version": "0.1.0",
  "identifier": "com.victoraguilar.studytime",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title":"Study.Time",
        "minWidth":600, 
        "width": 1200,
        "height": 800,
        "minHeight": 600,
        "decorations": true, 
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
